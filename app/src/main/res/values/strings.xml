    <!-- Privacy -->
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_summary">Permissions, local data and optional integrations</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_local_heading">What stays on your device</string>
    <string name="privacy_local_body">Niva stores your settings, favorites, folders and hidden apps only on this device. There are no accounts, no analytics, no advertising and no tracking. Niva never connects to the internet itself.</string>
    <string name="privacy_permissions_heading">Permissions Niva may request</string>
    <string name="privacy_perm_apps">See installed apps</string>
    <string name="privacy_perm_apps_summary">Required for any launcher: lists the apps you can open. Granted automatically, no prompt.</string>
    <string name="privacy_perm_calendar">Calendar</string>
    <string name="privacy_perm_calendar_summary">Only if you enable the agenda: shows your upcoming events on the home screen.</string>
    <string name="privacy_perm_contacts">Contacts</string>
    <string name="privacy_perm_contacts_summary">Only if you enable contact search: finds people by name from search. Nothing is uploaded.</string>
    <string name="privacy_perm_notifications">Notifications</string>
    <string name="privacy_perm_notifications_summary">Only if you enable the media player or notification previews: reads now-playing info and notification content locally to display it. Nothing leaves the device.</string>
    <string name="privacy_perm_accessibility">Accessibility</string>
    <string name="privacy_perm_accessibility_summary">Optional: enables the lock-screen gesture and opening quick settings. Niva does not read screen content.</string>
    <string name="privacy_perm_biometric">Biometric</string>
    <string name="privacy_perm_biometric_summary">Optional: unlocks the Private space with your fingerprint or face instead of a password.</string>
    <string name="privacy_perm_widgets">Widgets</string>
    <string name="privacy_perm_widgets_summary">Android asks you to confirm each widget you add. Niva cannot add widgets silently.</string>
    <string name="privacy_optional_heading">Optional integrations</string>
    <string name="privacy_optional_body">Each of these works only after you turn it on and grant its access. Turning one off immediately stops its data use.</string>
    <string name="privacy_toggle_contacts">Contact search</string>
    <string name="privacy_toggle_contacts_summary">Search people by name. Requires the Contacts permission.</string>
    <string name="privacy_toggle_agenda">Calendar agenda</string>
    <string name="privacy_toggle_agenda_summary">Show upcoming events. Requires the Calendar permission.</string>
    <string name="privacy_toggle_media">Media player</string>
    <string name="privacy_toggle_media_summary">Show now-playing controls. Requires notification access.</string>
    <string name="privacy_toggle_weather">Weather</string>
    <string name="privacy_toggle_weather_summary">Show weather from the optional Breezy Weather app.</string>
    <string name="privacy_limits_heading">Platform limits</string>
    <string name="privacy_limits_body">Android itself decides some things Niva cannot change: hiding an app in Niva does not uninstall or disable it, and it stays visible in Android\'s recents, notifications and other launchers. Focus Mode is a launcher-side filter only.</string>

